# Copy to a file outside the repository (for example ~/.config/anchor-memory/anchor.env),
# fill in the key, and load it before starting the server:  set -a; . ~/.config/anchor-memory/anchor.env; set +a
ANCHOR_EMBED_PROVIDER=siliconflow
ANCHOR_RERANK_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
